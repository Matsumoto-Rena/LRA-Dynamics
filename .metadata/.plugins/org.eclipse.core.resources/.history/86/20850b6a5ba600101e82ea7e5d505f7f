/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM2_Init();
  MX_TIM3_Init();
  MX_DAC1_Init();
  MX_TIM7_Init();
  /* USER CODE BEGIN 2 */
  HAL_GPIO_WritePin(D1_Pin_GPIO_Port, D1_Pin_Pin, SET);
  HAL_GPIO_WritePin(D2_Pin_GPIO_Port, D2_Pin_Pin, RESET);

//  HAL_TIM_Base_Start_IT(&htim7);

  t_sample_1 = (float)(M_PI / 170);
  t_sample_2 = (float)(M_PI / 340);
  HAL_DAC_Start(&hdac1, DAC_CHANNEL_1);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
//	  if (cnt_flag) {
//

//		  cnt_flag = false;
//	  }
  switch(direction) {
	  case DIRECTION1:
		  if(!switch_mode) {
			  t = t_sample_1 * n;
			  voltage = abs((float)max_voltage * sin(t));
			  HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, voltage);
			  tim_flag = false;

			  if (n < cnt) {
				  n++;
			  } else {
				  n = 0;
				  m++;
				  if(m != 4){
					  HAL_GPIO_WritePin(D1_Pin_GPIO_Port, D1_Pin_Pin, SET);
					  HAL_GPIO_WritePin(D2_Pin_GPIO_Port, D2_Pin_Pin, RESET);
				  } else {
					  HAL_GPIO_WritePin(D1_Pin_GPIO_Port, D1_Pin_Pin, RESET);
					  HAL_GPIO_WritePin(D2_Pin_GPIO_Port, D2_Pin_Pin, SET);
					  m = 0;
					  l++;
				  }
			  }

			  if(l > 250) {
				  switch_mode = true;
				  l = 0;
			  }

		  } else {
			  t = t_sample_1 * n;
			  voltage = abs((float)max_voltage * sin(t));
			  HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, voltage);
			  tim_flag = false;

			  if (n < cnt) {
				  n++;
			  } else {
				  n = 0;
				  m++;
				  if(m != 4){
					  HAL_GPIO_WritePin(D1_Pin_GPIO_Port, D1_Pin_Pin, RESET);
					  HAL_GPIO_WritePin(D2_Pin_GPIO_Port, D2_Pin_Pin, SET);
				  } else {
					  HAL_GPIO_WritePin(D1_Pin_GPIO_Port, D1_Pin_Pin, SET);
					  HAL_GPIO_WritePin(D2_Pin_GPIO_Port, D2_Pin_Pin, RESET);
					  m = 0;
					  l++;
				  }
			  }

			  if(l > 250) {
				  switch_mode = false;
				  l = 0;
			  }
		  }
		  break;

	  case DIRECTION2:
		  if(!switch_mode) {
			  t = t_sample_2 * n;
			  voltage = abs((float)max_voltage * sin(t));
			  HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, voltage);
			  tim_flag = false;

			  if (n < cnt) {
				  n++;
			  } else {
				  n = 0;
				  m++;
				  if(m != 4){
					  HAL_GPIO_WritePin(D1_Pin_GPIO_Port, D1_Pin_Pin, SET);
					  HAL_GPIO_WritePin(D2_Pin_GPIO_Port, D2_Pin_Pin, RESET);
				  } else {
					  HAL_GPIO_WritePin(D1_Pin_GPIO_Port, D1_Pin_Pin, RESET);
					  HAL_GPIO_WritePin(D2_Pin_GPIO_Port, D2_Pin_Pin, SET);
					  m = 0;
					  l++;
				  }
			  }

			  if(l > 250) {
				  switch_mode = true;
				  l = 0;
			  }

		  } else {
			  t = t_sample_2 * n;
			  voltage = abs((float)max_voltage * sin(t));
			  HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, voltage);
			  tim_flag = false;

			  if (n < cnt) {
				  n++;
			  } else {
				  n = 0;
				  m++;
				  if(m != 4){
					  HAL_GPIO_WritePin(D1_Pin_GPIO_Port, D1_Pin_Pin, RESET);
					  HAL_GPIO_WritePin(D2_Pin_GPIO_Port, D2_Pin_Pin, SET);
				  } else {
					  HAL_GPIO_WritePin(D1_Pin_GPIO_Port, D1_Pin_Pin, SET);
					  HAL_GPIO_WritePin(D2_Pin_GPIO_Port, D2_Pin_Pin, RESET);
					  m = 0;
					  l++;
				  }
			  }

			  if(l > 250) {
				  switch_mode = false;
				  l = 0;
			  }
		  }
		  break;


  }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

