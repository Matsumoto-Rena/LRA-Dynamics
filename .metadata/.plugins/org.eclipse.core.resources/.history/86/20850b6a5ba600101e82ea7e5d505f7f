void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim == &htim7){
    	if(tim_flag == false) {
    		tim_flag = true;
    	}
		n++;
		if(n > 6250) {
		  n = 0;
		  cnt_flag = true;
		}
    }
}
